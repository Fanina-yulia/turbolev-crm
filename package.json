{
  "name": "turbolev-crm",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-production.mjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "module:scope": "node scripts/module-scope.mjs",
    "module:ci": "node scripts/module-ci.mjs",
    "contracts:smoke": "tsx scripts/crm-core-contracts-smoke.ts && tsx scripts/planner-contracts-smoke.ts && tsx scripts/cabinet-home-contracts-smoke.ts && tsx scripts/service-advisor-contracts-smoke.ts && tsx scripts/clients-vehicles-contracts-smoke.ts && tsx scripts/client-card-contracts-smoke.ts && tsx scripts/new-request-wizard-contracts-smoke.ts && tsx scripts/inquiries-contracts-smoke.ts && node scripts/migration-database-url-smoke.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:smoke:telephony": "tsx scripts/production-telephony-smoke.ts",
    "data:mvs:import": "python3 scripts/import-mvs-open-data.py"
  },
  "dependencies": {
    "@neondatabase/auth": "0.4.2-beta",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.2",
    "next": "^15.5.0",
    "pg": "^8.13.1",
    "prisma": "^7.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}