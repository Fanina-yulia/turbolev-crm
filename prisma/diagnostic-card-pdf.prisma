// A generated PDF is immutable and tied to one diagnostic-card revision.
// Public sharing uses a separate hashed token, never the PDF row id.
model DiagnosticCardPdf {
  id                   String   @id @default(cuid())
  diagnosticCardId     String
  diagnosticCardRevisionId String @unique
  fileName             String   @db.VarChar(180)
  mimeType             String   @default("application/pdf") @db.VarChar(80)
  fileSize             Int
  fileData             Bytes
  generatedByUserId    String?
  generatedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  card     DiagnosticCard         @relation(fields: [diagnosticCardId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revision DiagnosticCardRevision @relation(fields: [diagnosticCardRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shares   DiagnosticCardPdfShare[]

  @@index([diagnosticCardId, generatedAt])
}

model DiagnosticCardPdfShare {
  id          String   @id @default(cuid())
  pdfId       String
  tokenHash   String   @unique @db.VarChar(64)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pdf DiagnosticCardPdf @relation(fields: [pdfId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([pdfId, createdAt])
  @@index([revokedAt, expiresAt])
}
