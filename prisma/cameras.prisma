enum CameraProvider {
  REOLINK
}

enum CameraPurpose {
  ENTRY
  EXIT
  TERRITORY
  SERVICE_POST
}

enum CameraConnectionMode {
  UID_P2P
  LOCAL
}

enum CameraStatus {
  NOT_TESTED
  CONNECTED
  ERROR
  DISABLED
}

enum CameraEventType {
  VEHICLE_DETECTED
  ENTRY
  EXIT
  SNAPSHOT
}

model Camera {
  id                String               @id @default(cuid())
  name              String               @db.VarChar(120)
  provider          CameraProvider       @default(REOLINK)
  uid               String               @unique @db.VarChar(40)
  username          String               @default("admin") @db.VarChar(80)
  encryptedPassword String               @db.Text
  purpose           CameraPurpose        @default(TERRITORY)
  connectionMode    CameraConnectionMode @default(UID_P2P)
  status            CameraStatus         @default(NOT_TESTED)
  model             String?              @db.VarChar(120)
  lastSeenAt        DateTime?
  lastTestAt        DateTime?
  lastTestMessage   String?              @db.Text
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  events CameraEvent[]

  @@index([purpose, isActive])
  @@index([status, updatedAt])
}

model CameraEvent {
  id              String          @id @default(cuid())
  cameraId        String
  vehicleId       String?
  workOrderId     String?
  eventType       CameraEventType @default(VEHICLE_DETECTED)
  plateNumber     String?         @db.VarChar(24)
  plateNormalized String?         @db.VarChar(24)
  confidence      Int?
  detectedAt      DateTime        @default(now())
  snapshotUrl     String?         @db.Text
  plateCropUrl    String?         @db.Text
  videoUrl        String?         @db.Text
  rawPayload      Json?
  createdAt       DateTime        @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, detectedAt])
  @@index([vehicleId, detectedAt])
  @@index([plateNormalized, detectedAt])
  @@index([workOrderId])
}
