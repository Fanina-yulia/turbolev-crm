enum CameraProvider {
  REOLINK
}

enum CameraPurpose {
  ENTRY
  EXIT
  TERRITORY
  SERVICE_POST
}

enum CameraConnectionMode {
  EMAIL_EVENTS
  UID_P2P
  LOCAL
}

enum CameraStatus {
  NOT_TESTED
  CONNECTED
  ERROR
  DISABLED
}

enum CameraEventType {
  VEHICLE_DETECTED
  ENTRY
  EXIT
  SNAPSHOT
}

enum CameraEventSource {
  GMAIL_EMAIL
  P2P_BRIDGE
  LOCAL_STREAM
}

enum CameraRecognitionStatus {
  PENDING
  RECOGNIZED
  REVIEW_REQUIRED
  IGNORED
}

model Camera {
  id                String               @id @default(cuid())
  name              String               @db.VarChar(120)
  provider          CameraProvider       @default(REOLINK)
  uid               String               @unique @db.VarChar(40)
  username          String               @default("admin") @db.VarChar(80)
  encryptedPassword String               @db.Text
  ingestTokenHash   String?              @db.VarChar(64)
  purpose           CameraPurpose        @default(TERRITORY)
  connectionMode    CameraConnectionMode @default(EMAIL_EVENTS)
  status            CameraStatus         @default(NOT_TESTED)
  model             String?              @db.VarChar(120)
  lastSeenAt        DateTime?
  lastTestAt        DateTime?
  lastTestMessage   String?              @db.Text
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  events CameraEvent[]

  @@index([purpose, isActive])
  @@index([status, updatedAt])
}

model CameraEvent {
  id                String                  @id @default(cuid())
  cameraId          String
  vehicleId         String?
  workOrderId       String?
  eventType         CameraEventType         @default(VEHICLE_DETECTED)
  source            CameraEventSource       @default(GMAIL_EMAIL)
  sourceEventId     String?                 @db.VarChar(180)
  plateNumber       String?                 @db.VarChar(24)
  plateNormalized   String?                 @db.VarChar(24)
  confidence        Int?
  recognitionStatus CameraRecognitionStatus @default(PENDING)
  detectedAt        DateTime                @default(now())
  snapshotUrl       String?                 @db.Text
  snapshotData      Bytes?
  snapshotMimeType  String?                 @db.VarChar(80)
  snapshotSize      Int?
  plateCropUrl      String?                 @db.Text
  videoUrl          String?                 @db.Text
  rawPayload        Json?
  createdAt         DateTime                @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([cameraId, sourceEventId])
  @@index([cameraId, detectedAt])
  @@index([vehicleId, detectedAt])
  @@index([plateNormalized, detectedAt])
  @@index([recognitionStatus, detectedAt])
  @@index([workOrderId])
}
