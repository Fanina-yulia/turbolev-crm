enum FinancialPnlSection {
  REVENUE
  COGS
  OPEX
  OTHER_INCOME
  OTHER_EXPENSE
  TAX
}

enum FinancialEventStatus {
  DRAFT
  POSTED
  REVERSED
}

enum FinancialObligationDirection {
  RECEIVABLE
  PAYABLE
}

enum FinancialObligationStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum MoneyAccountType {
  CASH
  BANK
  CARD
  ACQUIRING
  OTHER
}

enum CashTransactionKind {
  INFLOW
  OUTFLOW
  TRANSFER
}

enum CashTransactionStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CashFlowSection {
  OPERATING
  INVESTING
  FINANCING
  INTERNAL_TRANSFER
}

enum FinanceSnapshotKind {
  PLANNED
  ACTUAL
}

enum ExpenseDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  REVERSED
}

enum ExpensePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model MoneyAccount {
  id               String           @id @default(cuid())
  name             String
  type             MoneyAccountType
  currency         String           @default("UAH") @db.VarChar(3)
  openingBalance   Decimal          @default(0) @db.Decimal(14, 2)
  openingBalanceAt DateTime         @default(now())
  locationId       String?          @db.VarChar(64)
  isActive         Boolean          @default(true)
  sortOrder        Int              @default(100)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  incomingTransactions CashTransaction[] @relation("CashTransactionToAccount")
  outgoingTransactions CashTransaction[] @relation("CashTransactionFromAccount")

  @@index([isActive, sortOrder])
  @@index([locationId])
  @@index([currency])
}

model FinancialCategory {
  id              String               @id @default(cuid())
  code            String               @unique @db.VarChar(80)
  name            String
  pnlSection      FinancialPnlSection?
  cashFlowSection CashFlowSection?
  parentId        String?
  isSystem        Boolean              @default(false)
  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(100)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  parent      FinancialCategory?  @relation("FinancialCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    FinancialCategory[] @relation("FinancialCategoryTree")
  events      FinancialEvent[]
  obligations FinancialObligation[]
  cash        CashTransaction[]

  @@index([pnlSection, isActive])
  @@index([cashFlowSection, isActive])
  @@index([parentId, sortOrder])
}

model CostCenter {
  id         String   @id @default(cuid())
  code       String   @unique @db.VarChar(80)
  name       String
  locationId String?  @db.VarChar(64)
  isSystem   Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events      FinancialEvent[]
  obligations FinancialObligation[]
  cash        CashTransaction[]

  @@index([locationId])
  @@index([isActive, sortOrder])
}

model ExpenseDocument {
  id               String                @id @default(cuid())
  number           String                @unique @db.VarChar(32)
  status           ExpenseDocumentStatus @default(DRAFT)
  paymentStatus    ExpensePaymentStatus  @default(UNPAID)
  amount           Decimal               @db.Decimal(14, 2)
  paidAmount       Decimal               @default(0) @db.Decimal(14, 2)
  currency         String                @default("UAH") @db.VarChar(3)
  expenseDate      DateTime
  recognizedAt     DateTime
  paymentDate      DateTime?
  dueAt            DateTime?
  categoryId       String?
  costCenterId     String?
  locationId       String?               @db.VarChar(64)
  supplierId       String?               @db.VarChar(64)
  counterpartyName String?               @db.VarChar(240)
  moneyAccountId   String?               @db.VarChar(64)
  workOrderId      String?               @db.VarChar(64)
  clientId         String?               @db.VarChar(64)
  vehicleId        String?               @db.VarChar(64)
  supplierOrderId  String?               @db.VarChar(64)
  documentNumber   String?               @db.VarChar(120)
  description      String?               @db.Text
  notes            String?               @db.Text
  createdById      String?               @db.VarChar(64)
  approvedById     String?               @db.VarChar(64)
  approvedAt       DateTime?
  postedAt         DateTime?
  reversedAt       DateTime?
  reversalReason   String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  lines ExpenseLine[]

  @@index([status, expenseDate])
  @@index([paymentStatus, dueAt])
  @@index([categoryId, expenseDate])
  @@index([locationId, expenseDate])
  @@index([supplierId, expenseDate])
  @@index([moneyAccountId])
  @@index([workOrderId])
  @@index([supplierOrderId])
}

model ExpenseLine {
  id                String   @id @default(cuid())
  expenseDocumentId String
  lineNumber        Int
  description       String
  amount            Decimal  @db.Decimal(14, 2)
  quantity          Decimal? @db.Decimal(14, 4)
  unit              String?  @db.VarChar(32)
  unitPrice         Decimal? @db.Decimal(14, 2)
  categoryId        String?
  costCenterId      String?
  workOrderId       String?  @db.VarChar(64)
  supplierId        String?  @db.VarChar(64)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expenseDocument ExpenseDocument @relation(fields: [expenseDocumentId], references: [id], onDelete: Cascade)

  @@unique([expenseDocumentId, lineNumber])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([workOrderId])
  @@index([supplierId])
}

model FinancialEvent {
  id             String               @id @default(cuid())
  status         FinancialEventStatus @default(DRAFT)
  pnlSection     FinancialPnlSection
  amount         Decimal              @db.Decimal(14, 2)
  currency       String               @default("UAH") @db.VarChar(3)
  recognizedAt   DateTime
  categoryId     String?
  costCenterId   String?
  workOrderId    String?              @db.VarChar(64)
  clientId       String?              @db.VarChar(64)
  vehicleId      String?              @db.VarChar(64)
  supplierId     String?              @db.VarChar(64)
  employeeId     String?              @db.VarChar(64)
  locationId     String?              @db.VarChar(64)
  sourceEntity   String?              @db.VarChar(40)
  sourceEntityId String?              @db.VarChar(96)
  description    String?              @db.Text
  metadata       Json?
  reversalOfId   String?              @unique
  createdById    String?              @db.VarChar(64)
  postedAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  category    FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?         @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  reversalOf  FinancialEvent?     @relation("FinancialEventReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy  FinancialEvent?     @relation("FinancialEventReversal")
  obligations FinancialObligation[]

  @@index([status, recognizedAt])
  @@index([pnlSection, recognizedAt])
  @@index([categoryId, recognizedAt])
  @@index([costCenterId, recognizedAt])
  @@index([workOrderId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([supplierId])
  @@index([locationId])
  @@index([sourceEntity, sourceEntityId])
}

model FinancialObligation {
  id               String                       @id @default(cuid())
  direction        FinancialObligationDirection
  status           FinancialObligationStatus    @default(OPEN)
  amount           Decimal                      @db.Decimal(14, 2)
  settledAmount    Decimal                      @default(0) @db.Decimal(14, 2)
  currency         String                       @default("UAH") @db.VarChar(3)
  issuedAt         DateTime                     @default(now())
  dueAt            DateTime?
  settledAt        DateTime?
  categoryId       String?
  costCenterId     String?
  sourceEventId    String?
  workOrderId      String?                      @db.VarChar(64)
  clientId         String?                      @db.VarChar(64)
  supplierId       String?                      @db.VarChar(64)
  locationId       String?                      @db.VarChar(64)
  counterpartyName String?
  sourceEntity     String?                      @db.VarChar(40)
  sourceEntityId   String?                      @db.VarChar(96)
  description      String?                      @db.Text
  metadata         Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  category    FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?         @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  sourceEvent FinancialEvent?     @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  cash        CashTransaction[]

  @@index([direction, status, dueAt])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([sourceEventId])
  @@index([workOrderId])
  @@index([clientId])
  @@index([supplierId])
  @@index([locationId])
  @@index([sourceEntity, sourceEntityId])
}

model CashTransaction {
  id             String                @id @default(cuid())
  kind           CashTransactionKind
  status         CashTransactionStatus @default(DRAFT)
  flowSection    CashFlowSection
  amount         Decimal               @db.Decimal(14, 2)
  currency       String                @default("UAH") @db.VarChar(3)
  occurredAt     DateTime
  fromAccountId  String?
  toAccountId    String?
  categoryId     String?
  costCenterId   String?
  obligationId   String?
  workOrderId    String?               @db.VarChar(64)
  clientId       String?               @db.VarChar(64)
  supplierId     String?               @db.VarChar(64)
  locationId     String?               @db.VarChar(64)
  sourceEntity   String?               @db.VarChar(40)
  sourceEntityId String?               @db.VarChar(96)
  description    String?               @db.Text
  metadata       Json?
  reversalOfId   String?               @unique
  createdById    String?               @db.VarChar(64)
  postedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  fromAccount MoneyAccount?        @relation("CashTransactionFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   MoneyAccount?        @relation("CashTransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category    FinancialCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  obligation  FinancialObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  reversalOf  CashTransaction?     @relation("CashTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy  CashTransaction?     @relation("CashTransactionReversal")

  @@index([status, occurredAt])
  @@index([kind, occurredAt])
  @@index([flowSection, occurredAt])
  @@index([fromAccountId, occurredAt])
  @@index([toAccountId, occurredAt])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([obligationId])
  @@index([workOrderId])
  @@index([clientId])
  @@index([supplierId])
  @@index([locationId])
  @@index([sourceEntity, sourceEntityId])
}

model WorkOrderFinanceSnapshot {
  id                 String              @id @default(cuid())
  workOrderId        String              @db.VarChar(64)
  kind               FinanceSnapshotKind
  currency           String              @default("UAH") @db.VarChar(3)
  laborRevenue       Decimal             @default(0) @db.Decimal(14, 2)
  partsRevenue       Decimal             @default(0) @db.Decimal(14, 2)
  externalRevenue    Decimal             @default(0) @db.Decimal(14, 2)
  otherRevenue       Decimal             @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(14, 2)
  refundAmount       Decimal             @default(0) @db.Decimal(14, 2)
  partsCost          Decimal             @default(0) @db.Decimal(14, 2)
  laborCost          Decimal             @default(0) @db.Decimal(14, 2)
  externalCost       Decimal             @default(0) @db.Decimal(14, 2)
  consumablesCost    Decimal             @default(0) @db.Decimal(14, 2)
  otherDirectCost    Decimal             @default(0) @db.Decimal(14, 2)
  grossRevenue       Decimal             @default(0) @db.Decimal(14, 2)
  directCost         Decimal             @default(0) @db.Decimal(14, 2)
  grossProfit        Decimal             @default(0) @db.Decimal(14, 2)
  grossMarginPercent Decimal?            @db.Decimal(7, 2)
  calculatedAt       DateTime            @default(now())
  lockedAt           DateTime?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([workOrderId, kind])
  @@index([kind, calculatedAt])
  @@index([workOrderId])
}

// Financial Center V2 planning layer. These models store plans and controls only;
// FinancialEvent, FinancialObligation and CashTransaction remain the sole factual ledger.
model FinancialBudget {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(160)
  metric       String   @db.VarChar(40)
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("UAH") @db.VarChar(3)
  periodStart  DateTime
  periodEnd    DateTime
  categoryId   String?  @db.VarChar(80)
  costCenterId String?  @db.VarChar(80)
  locationId   String?  @db.VarChar(64)
  status       String   @default("ACTIVE") @db.VarChar(24)
  notes        String?  @db.Text
  createdById  String?  @db.VarChar(64)
  approvedById String?  @db.VarChar(64)
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([periodStart, periodEnd, status])
  @@index([locationId, periodStart, periodEnd])
  @@index([categoryId, periodStart, periodEnd])
  @@index([costCenterId, periodStart, periodEnd])
  @@index([metric, periodStart, periodEnd])
}

model RecurringFinancialRule {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(180)
  direction        String   @default("OUTFLOW") @db.VarChar(16)
  amount           Decimal  @db.Decimal(14, 2)
  currency         String   @default("UAH") @db.VarChar(3)
  frequency        String   @default("MONTHLY") @db.VarChar(24)
  intervalCount    Int      @default(1)
  dayOfMonth       Int?
  dayOfWeek        Int?
  startAt          DateTime
  endAt            DateTime?
  nextOccurrenceAt DateTime
  categoryId       String?  @db.VarChar(80)
  costCenterId     String?  @db.VarChar(80)
  locationId       String?  @db.VarChar(64)
  counterpartyName String?  @db.VarChar(240)
  moneyAccountId   String?  @db.VarChar(64)
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  autoPost         Boolean  @default(false)
  createdById      String?  @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, nextOccurrenceAt])
  @@index([locationId, isActive])
  @@index([categoryId, isActive])
}

model FinancialForecastItem {
  id                      String   @id @default(cuid())
  direction               String   @db.VarChar(16)
  status                  String   @default("PLANNED") @db.VarChar(24)
  amount                  Decimal  @db.Decimal(14, 2)
  currency                String   @default("UAH") @db.VarChar(3)
  expectedAt              DateTime
  probability             Int      @default(100)
  categoryId              String?  @db.VarChar(80)
  costCenterId            String?  @db.VarChar(80)
  locationId              String?  @db.VarChar(64)
  moneyAccountId          String?  @db.VarChar(64)
  counterpartyName        String?  @db.VarChar(240)
  sourceEntity            String?  @db.VarChar(40)
  sourceEntityId          String?  @db.VarChar(96)
  actualCashTransactionId String?  @db.VarChar(96)
  description             String?  @db.Text
  createdById             String?  @db.VarChar(64)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status, expectedAt])
  @@index([locationId, expectedAt])
  @@index([sourceEntity, sourceEntityId])
}

model FinancialApprovalRule {
  id                 String   @id @default(cuid())
  name               String   @db.VarChar(160)
  operationType      String   @default("EXPENSE") @db.VarChar(32)
  minAmount          Decimal  @default(0) @db.Decimal(14, 2)
  maxAmount          Decimal? @db.Decimal(14, 2)
  locationId         String?  @db.VarChar(64)
  requiredPermission String?  @db.VarChar(96)
  requiredRole       String?  @db.VarChar(96)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([operationType, isActive, sortOrder])
  @@index([locationId, isActive])
}

model FinancialSettings {
  id                        String   @id @default(cuid())
  scopeKey                  String   @unique @db.VarChar(80)
  locationId                String?  @db.VarChar(64)
  defaultCurrency           String   @default("UAH") @db.VarChar(3)
  minimumCashReserve        Decimal  @default(0) @db.Decimal(14, 2)
  fixedMonthlyCosts         Decimal  @default(0) @db.Decimal(14, 2)
  targetGrossMarginPercent  Decimal  @default(40) @db.Decimal(7, 2)
  warningGrossMarginPercent Decimal  @default(25) @db.Decimal(7, 2)
  forecastHorizonDays       Int      @default(90)
  updatedById               String?  @db.VarChar(64)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([locationId])
}

model ExpenseAttachment {
  id                String   @id @default(cuid())
  expenseDocumentId String   @db.VarChar(96)
  fileName          String   @db.VarChar(240)
  mimeType          String   @db.VarChar(120)
  url               String   @db.Text
  sizeBytes         Int?
  uploadedById      String?  @db.VarChar(64)
  createdAt         DateTime @default(now())

  @@index([expenseDocumentId, createdAt])
}

model CustomerAdvance {
  id                      String   @id @default(cuid())
  clientId                String   @db.VarChar(64)
  workOrderId             String?  @db.VarChar(64)
  amount                  Decimal  @db.Decimal(14, 2)
  appliedAmount           Decimal  @default(0) @db.Decimal(14, 2)
  currency                String   @default("UAH") @db.VarChar(3)
  receivedAt              DateTime
  moneyAccountId          String   @db.VarChar(64)
  locationId              String?  @db.VarChar(64)
  cashTransactionId       String   @unique @db.VarChar(96)
  status                  String   @default("OPEN") @db.VarChar(24)
  description             String?  @db.Text
  createdById             String?  @db.VarChar(64)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([clientId, status])
  @@index([workOrderId])
  @@index([locationId, status])
}