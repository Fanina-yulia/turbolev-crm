enum ServiceCompletionActStatus {
  ISSUED
  CANCELLED
}

model ServiceCompletionAct {
  id             String                    @id @default(cuid())
  workOrderId    String                    @unique
  actNumber      String                    @unique @db.VarChar(64)
  status         ServiceCompletionActStatus @default(ISSUED)
  currency       String                    @default("UAH") @db.VarChar(3)
  lineSnapshot   Json
  totalAmount    Decimal                   @default(0) @db.Decimal(14, 2)
  issuedAt       DateTime                  @default(now())
  issuedByName   String?                   @db.VarChar(160)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  workOrder      WorkOrder                 @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([status, issuedAt])
}
