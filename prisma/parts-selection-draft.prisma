model DiagnosticPartSelectionDraft {
  id                    String   @id @default(cuid())
  diagnosticRequestId   String
  findingId             String?
  manualPartId          String?
  selectionKey          String   @db.VarChar(190)
  partName              String   @db.VarChar(500)
  position              String?  @db.VarChar(120)
  genericArticleId      String?
  canonicalCode         String?  @db.VarChar(80)
  quantity              Decimal  @default(1) @db.Decimal(12, 3)
  supplierProvider      String   @db.VarChar(80)
  supplierDbId          String?
  supplierName          String   @db.VarChar(180)
  supplierQuoteId       String?
  externalProductId     String?  @db.VarChar(200)
  article               String   @db.VarChar(120)
  brand                 String?  @db.VarChar(120)
  warehouse             String?  @db.VarChar(180)
  purchasePrice         Decimal  @db.Decimal(14, 2)
  sellPrice             Decimal  @db.Decimal(14, 2)
  markupPercent         Decimal? @db.Decimal(7, 2)
  currency              String   @default("UAH") @db.VarChar(3)
  fitment               Json?
  offerEvidence         Json?
  manualFields          Json?
  priceOverrideReason   String?  @db.Text
  createdByUserId       String?
  createdByName         String?  @db.VarChar(160)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([diagnosticRequestId, selectionKey])
  @@index([diagnosticRequestId, updatedAt])
  @@index([findingId])
  @@index([manualPartId])
  @@index([supplierDbId])
}
