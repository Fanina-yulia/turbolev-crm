generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CallType {
  INCOMING
  OUTGOING
}

enum CallStatus {
  ANSWERED
  MISSED
  BUSY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ESTIMATE
  WAITING
  NO_ANSWER
  BOOKED
  ARRIVED
  LOST

  // Legacy values kept for backward compatibility with existing records/API.
  QUALIFYING
  WARM_LEAD
  REJECTED
  SPAM_WRONG
  SUPPLIER_PARTNER
}

enum RejectReason {
  TOO_EXPENSIVE
  NO_CAPACITY_NO_TIME
  SERVICE_NOT_PROVIDED
  WRONG_NUMBER
  SPAM_ADS
  OTHER
}

enum LeadSource {
  BINOTEL
  WEBSITE
  PHONE
  MESSENGER
  INSTAGRAM
  FACEBOOK
  GOOGLE_MAPS
  VIBER
  WHATSAPP
  OLX
  TIKTOK
  REFERRAL
  WALK_IN
  OTHER
}

enum DiagnosticRequestStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  CANCELLED
}

enum CommunicationChannel {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  BINOTEL
  OLX
  WEBSITE
}

enum InquiryState {
  NEW
  IN_WORK
  CONVERTED
  LINKED
  SPAM
}

enum MessageDirection {
  IN
  OUT
  SYSTEM
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String?       @unique
  internalNumber String?       @unique
  authUserId     String?       @unique @db.VarChar(128)
  isActive       Boolean       @default(true)
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  managedCalls           CallHistory[]          @relation("CallManager")
  assignedLeads          Lead[]                 @relation("LeadAssignee")
  communicationInquiries CommunicationInquiry[] @relation("CommunicationAssignee")
  employeeProfile        EmployeeProfile?
  accessRoles            UserAccessRole[]
  permissionOverrides    UserPermissionOverride[]

  @@index([authUserId, isActive])
}

model Client {
  id              String   @id @default(cuid())
  name            String?
  phone           String   @unique
  phoneNormalized String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phones             ClientPhone[]
  vehicles           Vehicle[]
  diagnosticRequests DiagnosticRequest[]
  workOrders         WorkOrder[]
  calls              CallHistory[]
}

model ClientPhone {
  id              String   @id
  clientId        String
  phone           String
  phoneNormalized String   @unique
  label           String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isPrimary])
}

model Vehicle {
  id                       String   @id @default(cuid())
  clientId                 String
  plateNumber              String?  @unique
  plateNormalized          String?  @unique
  brand                    String?
  model                    String?
  vin                      String?  @unique
  year                     Int?
  mileageKm                Int?
  engineName               String?
  engineVolumeCm3          Int?
  fuelType                 String?
  bodyType                 String?
  grossWeightKg            Int?
  driveType                String?
  vehicleType              String?
  turboLevClass            String?
  priceCoefficient         Decimal  @default(1.00) @db.Decimal(4, 2)
  classificationSource     String?
  classificationConfidence Int?
  manualClassOverride      Boolean  @default(false)
  vehicleDataSource        String?
  vehicleDataConfidence    Int?
  lastVehicleLookupAt      DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  registrations      VehicleRegistration[]
  diagnosticRequests DiagnosticRequest[]
  workOrders         WorkOrder[]

  @@index([clientId])
  @@index([brand, model])
  @@index([turboLevClass])
}

model VehicleRegistration {
  id              String   @id @default(cuid())
  vehicleId       String
  countryCode     String   @db.VarChar(2)
  plateNumber     String   @db.VarChar(24)
  plateNormalized String   @db.VarChar(24)
  source          String?  @db.VarChar(40)
  isCurrent       Boolean  @default(true)
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([countryCode, plateNormalized])
  @@index([vehicleId, isCurrent])
}

model VinDecodeCache {
  vin             String   @id @db.VarChar(17)
  source          String   @db.VarChar(40)
  providerVersion String?  @db.VarChar(24)
  confidence      Int
  vehicle         Json
  fieldConfidence Json
  validation      Json
  decodedAt       DateTime @default(now())
  expiresAt       DateTime?
  lastError       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([source, updatedAt])
  @@index([expiresAt])
}

// Compact, read-optimized cache of open MVS data.
// Only the latest known record for a registration plate is stored.
model VehicleRegistryEntry {
  plateNormalized  String   @id @db.VarChar(10)
  vin              String?  @db.VarChar(17)
  brand            String?  @db.VarChar(48)
  model            String?  @db.VarChar(64)
  makeYear         Int?     @db.SmallInt
  engineVolumeCm3  Int?
  fuelType         String?  @db.VarChar(24)
  bodyType         String?  @db.VarChar(40)
  vehicleKind      String?  @db.VarChar(40)
  grossWeightKg    Int?
  registrationDate String?  @db.VarChar(16)
  sourceYear       Int      @db.SmallInt
}

model DiagnosticRequest {
  id                  String                  @id @default(cuid())
  clientId            String
  vehicleId           String
  leadId              String?
  status              DiagnosticRequestStatus @default(PENDING)
  technicalConclusion String?                 @db.Text
  confirmedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  lead      Lead? @relation("LeadDiagnostics", fields: [leadId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?

  @@index([clientId, status])
  @@index([vehicleId, status])
  @@index([leadId])
  @@index([createdAt])
}

model WorkOrder {
  id                  String   @id @default(cuid())
  clientId            String
  vehicleId           String
  diagnosticRequestId String   @unique
  status              String   @default("PARTS_REVIEW")
  closedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  diagnosticRequest DiagnosticRequest @relation(fields: [diagnosticRequestId], references: [id], onDelete: Restrict)
  calls             CallHistory[]
  lines             WorkOrderLine[]
  estimates         WorkOrderEstimate[]
  partsRequests     PartsRequest[]
  qualityControls   WorkOrderQualityControl[]

  @@index([clientId, closedAt])
  @@index([vehicleId, closedAt])
  @@index([status, updatedAt])
}

model Lead {
  id                String        @id @default(cuid())
  name              String?
  phone             String
  phoneNormalized   String
  status            LeadStatus    @default(NEW)
  source            LeadSource    @default(OTHER)
  carBrand          String?
  carModel          String?
  carYear           Int?
  plateNumber       String?       @db.VarChar(24)
  vin               String?
  need              String?       @db.Text
  comment           String?       @db.Text
  rejectReason      RejectReason?
  nextAction        String?       @db.Text
  nextContactAt     DateTime?
  contactAttempts   Int           @default(0)
  lastActivityAt    DateTime      @default(now())
  preliminaryAmount Decimal?      @db.Decimal(14, 2)
  assignedUserId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignedUser           User?                  @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  calls                  CallHistory[]
  diagnosticRequests     DiagnosticRequest[]    @relation("LeadDiagnostics")
  communicationInquiries CommunicationInquiry[]

  @@index([phone])
  @@index([phoneNormalized])
  @@index([status, updatedAt])
  @@index([source, createdAt])
  @@index([assignedUserId, status])
  @@index([nextContactAt])
  @@index([lastActivityAt])
  @@index([plateNumber])
}

model CallHistory {
  id             String      @id @default(cuid())
  binotelCallId  String      @unique
  externalNumber String
  internalNumber String?
  type           CallType
  status         CallStatus?
  duration       Int         @default(0)
  recordingUrl   String?     @db.Text
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  rawPayload     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leadId      String?
  clientId    String?
  workOrderId String?
  managerId   String?

  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  manager   User?      @relation("CallManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([externalNumber, createdAt])
  @@index([internalNumber, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([leadId])
  @@index([clientId])
  @@index([workOrderId])
  @@index([managerId])
}

model CommunicationInquiry {
  id              String               @id
  externalId      String?
  channel         CommunicationChannel
  state           InquiryState         @default(NEW)
  name            String?
  phone           String?
  phoneNormalized String?
  handle          String?
  subject         String
  preview         String
  vehicle         String?
  plate           String?
  plateNormalized String?
  unread          Boolean              @default(true)
  answered        Boolean              @default(false)
  receivedAt      DateTime
  sourceDetail    String?
  campaign        String?
  utm             String?
  leadId          String?
  assignedUserId  String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

  lead         Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignedUser User?                  @relation("CommunicationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  messages     CommunicationMessage[]

  @@unique([channel, externalId], map: "CommunicationInquiry_channel_externalId_key")
  @@index([channel, receivedAt])
  @@index([state, receivedAt])
  @@index([phoneNormalized])
  @@index([plateNormalized])
  @@index([assignedUserId, state])
}

model CommunicationMessage {
  id         String           @id
  inquiryId  String
  externalId String?
  direction  MessageDirection
  text       String
  sentAt     DateTime
  metadata   Json?
  createdAt  DateTime         @default(now())

  inquiry CommunicationInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([inquiryId, externalId], map: "CommunicationMessage_inquiry_externalId_key")
  @@index([inquiryId, sentAt])
}

model WebhookEvent {
  id              String               @id
  channel         CommunicationChannel
  externalEventId String
  eventType       String?
  payload         Json
  status          String               @default("RECEIVED")
  processedAt     DateTime?
  error           String?
  createdAt       DateTime             @default(now())

  @@unique([channel, externalEventId], map: "WebhookEvent_channel_externalEventId_key")
  @@index([status, createdAt])
}
