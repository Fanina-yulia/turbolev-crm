generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CallType {
  INCOMING
  OUTGOING
}

enum CallStatus {
  ANSWERED
  MISSED
  BUSY
}

enum LeadStatus {
  NEW
  QUALIFYING
  BOOKED
  ARRIVED
  WARM_LEAD
  REJECTED
  SPAM_WRONG
  SUPPLIER_PARTNER
}

enum RejectReason {
  TOO_EXPENSIVE
  NO_CAPACITY_NO_TIME
  SERVICE_NOT_PROVIDED
  WRONG_NUMBER
  SPAM_ADS
  OTHER
}

enum LeadSource {
  BINOTEL
  WEBSITE
  PHONE
  MESSENGER
  WALK_IN
  OTHER
}

enum DiagnosticRequestStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  CANCELLED
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String?       @unique
  internalNumber String?       @unique
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  managedCalls   CallHistory[] @relation("CallManager")
  assignedLeads  Lead[]        @relation("LeadAssignee")
}

model Client {
  id              String              @id @default(cuid())
  name            String?
  phone           String              @unique
  phoneNormalized String              @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vehicles           Vehicle[]
  diagnosticRequests DiagnosticRequest[]
  workOrders         WorkOrder[]
  calls              CallHistory[]
}

model Vehicle {
  id                       String   @id @default(cuid())
  clientId                 String
  plateNumber              String?  @unique
  plateNormalized          String?  @unique
  brand                    String?
  model                    String?
  vin                      String?  @unique
  year                     Int?
  mileageKm                Int?
  engineName               String?
  engineVolumeCm3          Int?
  fuelType                 String?
  bodyType                 String?
  grossWeightKg            Int?
  driveType                String?
  vehicleType              String?
  turboLevClass            String?
  priceCoefficient         Decimal  @default(1.00) @db.Decimal(4, 2)
  classificationSource     String?
  classificationConfidence Int?
  manualClassOverride      Boolean  @default(false)
  vehicleDataSource        String?
  vehicleDataConfidence    Int?
  lastVehicleLookupAt      DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  diagnosticRequests DiagnosticRequest[]
  workOrders         WorkOrder[]

  @@index([clientId])
  @@index([brand, model])
  @@index([turboLevClass])
}

model VehicleRegistryEntry {
  id               BigInt   @id @default(autoincrement())
  plateNormalized  String
  vin              String?
  brand            String?
  model            String?
  makeYear         Int?
  engineVolumeCm3  Int?
  fuelType         String?
  bodyType         String?
  vehicleKind      String?
  grossWeightKg    Int?
  registrationDate String?
  sourceYear       Int
  importedAt       DateTime @default(now())

  @@unique([plateNormalized, sourceYear, vin])
  @@index([plateNormalized])
  @@index([vin])
  @@index([brand, model])
  @@index([sourceYear])
}

model DiagnosticRequest {
  id                  String                  @id @default(cuid())
  clientId            String
  vehicleId           String
  leadId              String?
  status              DiagnosticRequestStatus @default(PENDING)
  technicalConclusion String?                 @db.Text
  confirmedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  lead      Lead? @relation("LeadDiagnostics", fields: [leadId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?

  @@index([clientId, status])
  @@index([vehicleId, status])
  @@index([leadId])
  @@index([createdAt])
}

model WorkOrder {
  id                  String   @id @default(cuid())
  clientId            String
  vehicleId           String
  diagnosticRequestId String   @unique
  status              String   @default("PARTS_REVIEW")
  closedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  diagnosticRequest DiagnosticRequest @relation(fields: [diagnosticRequestId], references: [id], onDelete: Restrict)
  calls             CallHistory[]

  @@index([clientId, closedAt])
  @@index([vehicleId, closedAt])
  @@index([status, updatedAt])
}

model Lead {
  id              String        @id @default(cuid())
  name            String?
  phone           String
  phoneNormalized String
  status          LeadStatus    @default(NEW)
  source          LeadSource    @default(OTHER)
  carBrand        String?
  carModel        String?
  vin             String?
  comment         String?       @db.Text
  rejectReason    RejectReason?
  nextContactAt   DateTime?
  assignedUserId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedUser       User?               @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  calls              CallHistory[]
  diagnosticRequests DiagnosticRequest[] @relation("LeadDiagnostics")

  @@index([phone])
  @@index([phoneNormalized])
  @@index([status, updatedAt])
  @@index([source, createdAt])
  @@index([assignedUserId, status])
  @@index([nextContactAt])
}

model CallHistory {
  id             String      @id @default(cuid())
  binotelCallId  String      @unique
  externalNumber String
  internalNumber String?
  type           CallType
  status         CallStatus?
  duration       Int         @default(0)
  recordingUrl   String?     @db.Text
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  rawPayload     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leadId      String?
  clientId    String?
  workOrderId String?
  managerId   String?

  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  manager   User?      @relation("CallManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([externalNumber, createdAt])
  @@index([internalNumber, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([leadId])
  @@index([clientId])
  @@index([workOrderId])
  @@index([managerId])
}
