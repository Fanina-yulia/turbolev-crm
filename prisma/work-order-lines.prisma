enum WorkOrderLineType {
  LABOR
  PART
  EXTERNAL
  CONSUMABLE
  OTHER
}

enum WorkOrderLineStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrderLine {
  id               String              @id @default(cuid())
  workOrderId      String
  type             WorkOrderLineType
  status           WorkOrderLineStatus @default(DRAFT)
  description      String
  code             String?             @db.VarChar(120)
  article          String?             @db.VarChar(120)
  brand            String?             @db.VarChar(120)
  unit             String              @default("шт") @db.VarChar(32)
  currency         String              @default("UAH") @db.VarChar(3)

  plannedQuantity  Decimal             @default(1) @db.Decimal(12, 3)
  plannedUnitPrice Decimal             @default(0) @db.Decimal(14, 2)
  plannedUnitCost  Decimal             @default(0) @db.Decimal(14, 2)
  plannedDiscount  Decimal             @default(0) @db.Decimal(14, 2)

  actualQuantity   Decimal?            @db.Decimal(12, 3)
  actualUnitPrice  Decimal?            @db.Decimal(14, 2)
  actualUnitCost   Decimal?            @db.Decimal(14, 2)
  actualDiscount   Decimal?            @db.Decimal(14, 2)

  laborHours       Decimal?            @db.Decimal(8, 2)
  mechanicId       String?
  supplierId       String?
  supplierQuoteId  String?
  supplierOrderId  String?
  catalogItemId    String?
  sourceEntity     String?             @db.VarChar(40)
  sourceEntityId   String?             @db.VarChar(96)
  sortOrder        Int                 @default(100)

  approvedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workOrder        WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([workOrderId, status, sortOrder])
  @@index([workOrderId, type])
  @@index([supplierId])
  @@index([supplierQuoteId])
  @@index([supplierOrderId])
  @@index([mechanicId])
  @@index([catalogItemId])
  @@index([sourceEntity, sourceEntityId])
}
