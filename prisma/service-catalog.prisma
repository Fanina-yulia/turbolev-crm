enum ServiceCatalogSource {
  TURBO_LEV_LEGACY
  MS_MASTER
  MANUAL
}

enum ServiceCatalogItemType {
  LABOR
  DIAGNOSTIC
  MATERIAL
  INFORMATION
  CHECKLIST
  RENT
  PARKING
  WASH
  OTHER
}

enum ServiceCatalogReviewStatus {
  READY
  NEEDS_REVIEW
  QUARANTINED
}

enum ServiceCatalogBodySide {
  LEFT
  RIGHT
}

enum ServiceCatalogCalculatorOperation {
  REPLACE_NO_PAINT
  REPLACE_WITH_PAINT
  PAINT_NO_REPAIR
  LIGHT_REPAIR
  LIGHT_REPAIR_PAINT
  COMPLEX_REPAIR
  COMPLEX_REPAIR_PAINT
}

enum ServiceCatalogPayrollType {
  NONE
  PERCENT_NORM_HOURS
}

model ServiceCatalogCategory {
  id        String   @id
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(180)
  sortOrder Int      @default(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ServiceCatalogItem[]

  @@index([isActive, sortOrder])
}

model ServiceCatalogImportBatch {
  id              String               @id @default(cuid())
  source          ServiceCatalogSource
  fileName        String               @db.VarChar(255)
  fileSha256      String?              @db.VarChar(64)
  sourceVersion   String?              @db.VarChar(255)
  totalRows       Int                  @default(0)
  readyRows       Int                  @default(0)
  reviewRows      Int                  @default(0)
  quarantinedRows Int                  @default(0)
  createdRows     Int                  @default(0)
  updatedRows     Int                  @default(0)
  activatedRows   Int                  @default(0)
  metadata        Json?
  createdAt       DateTime             @default(now())

  items ServiceCatalogItem[]

  @@index([source, createdAt])
}

model ServiceCatalogItem {
  id                        String                            @id @default(cuid())
  source                    ServiceCatalogSource
  externalServiceId         String?                           @db.VarChar(64)
  code                      String?                           @db.VarChar(64)
  legacyDirectoryItemId     String?                           @unique @db.VarChar(128)

  internalName              String                            @db.Text
  displayName               String                            @db.Text
  searchAliases             String[]                          @default([])
  categoryId                String?
  sourceCategory            String?                           @db.VarChar(180)
  itemType                  ServiceCatalogItemType            @default(LABOR)

  basePrice                 Decimal?                          @db.Decimal(14, 2)
  currency                  String                            @default("UAH") @db.VarChar(3)
  unit                      String                            @default("роб") @db.VarChar(32)
  defaultQuantity           Decimal                           @default(1) @db.Decimal(12, 3)
  normMinutes               Int?
  complexSurcharge          Decimal?                          @db.Decimal(10, 2)
  vehicleCoefficientEnabled Boolean                           @default(true)

  warrantyKm                Int?
  warrantyDays              Int?

  payrollCategory           String?                           @db.VarChar(180)
  payrollType               ServiceCatalogPayrollType         @default(NONE)
  mechanicPercent           Decimal?                          @db.Decimal(7, 3)
  mechanicFixedAmount       Decimal?                          @db.Decimal(14, 2)

  bodyPart                  String?                           @db.VarChar(180)
  bodySide                  ServiceCatalogBodySide?
  calculatorOperation       ServiceCatalogCalculatorOperation?

  isActive                  Boolean                           @default(false)
  showToOperator            Boolean                           @default(false)
  showToClient              Boolean                           @default(false)
  showOnLanding             Boolean                           @default(false)
  reviewStatus              ServiceCatalogReviewStatus        @default(NEEDS_REVIEW)
  reviewReason              String?                           @db.Text

  sourceRow                 Int?
  sourceVersion             String?                           @db.VarChar(255)
  originalData              Json?
  importBatchId             String?
  importedAt                DateTime                          @default(now())
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt

  category                  ServiceCatalogCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch               ServiceCatalogImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([source, externalServiceId])
  @@index([isActive, reviewStatus, itemType])
  @@index([categoryId, isActive, displayName])
  @@index([source, reviewStatus])
  @@index([code])
  @@index([bodyPart, bodySide, calculatorOperation])
  @@index([importBatchId])
}
