enum SecurityEnforcementMode {
  SHADOW
  ENFORCED
}

enum AccessScope {
  SELF
  ASSIGNED
  TEAM
  LOCATION
  ALL
}

enum PermissionEffect {
  ALLOW
  DENY
}

model SecurityConfig {
  id                    String                  @id @default("default") @db.VarChar(32)
  enforcementMode       SecurityEnforcementMode @default(SHADOW)
  bootstrapCompleted    Boolean                 @default(false)
  allowSelfRegistration Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model AccessRole {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isSystem    Boolean  @default(true)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AccessRolePermission[]
  users       UserAccessRole[]

  @@index([isActive, sortOrder])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(96)
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  description String?  @db.Text
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles     AccessRolePermission[]
  overrides UserPermissionOverride[]

  @@index([module, action])
  @@index([isSensitive])
}

model AccessRolePermission {
  id           String      @id @default(cuid())
  roleId       String
  permissionId String
  scope        AccessScope @default(ALL)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId, roleId])
}

model UserAccessRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  locationId String?
  isPrimary  Boolean   @default(false)
  isActive   Boolean   @default(true)
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  reason     String?   @db.VarChar(240)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     AccessRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  location ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, locationId])
  @@index([userId, isActive, startsAt, endsAt])
  @@index([roleId, isActive])
  @@index([locationId, isActive])
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  effect       PermissionEffect
  scope        AccessScope      @default(ALL)
  locationId   String?
  reason       String?          @db.VarChar(240)
  startsAt     DateTime         @default(now())
  expiresAt    DateTime?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  location   ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, startsAt, expiresAt])
  @@index([permissionId, effect])
  @@index([locationId, isActive])
}
