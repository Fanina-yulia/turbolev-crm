/// Evidence-first parts search audit. These tables intentionally store stable IDs
/// rather than Prisma relations to operational entities so audit rows survive
/// catalog merges, vehicle archival and future provider migrations.
model PartSearchRun {
  id               String   @id @default(cuid())
  vehicleId        String?  @db.VarChar(160)
  vin              String?  @db.VarChar(40)
  plate            String?  @db.VarChar(40)
  query            String   @db.VarChar(240)
  canonicalCode    String?  @db.VarChar(80)
  axis             String?  @db.VarChar(16)
  side             String?  @db.VarChar(16)
  algorithmVersion String   @default("EVIDENCE_FIRST_V3") @db.VarChar(64)
  status           String   @default("RUNNING") @db.VarChar(32)
  evidenceDriven   Boolean  @default(false)
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  totalDurationMs  Int?
  rawOfferCount    Int      @default(0)
  acceptedCount    Int      @default(0)
  rejectedCount    Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  decisions PartSearchDecision[]

  @@index([vehicleId, createdAt])
  @@index([canonicalCode, createdAt])
  @@index([status, createdAt])
  @@index([algorithmVersion, createdAt])
}

model PartSearchDecision {
  id                    String   @id @default(cuid())
  searchRunId           String
  supplierId            String?  @db.VarChar(64)
  externalProductId     String?  @db.VarChar(180)
  brand                 String?  @db.VarChar(120)
  article               String?  @db.VarChar(180)
  name                  String   @db.VarChar(320)
  detectedCanonicalCode String?  @db.VarChar(80)
  decision              String   @db.VarChar(24)
  evidenceTier          String   @db.VarChar(48)
  reasonCode            String?  @db.VarChar(64)
  reason                 String   @db.Text
  score                 Int      @default(0)
  metadata              Json?
  createdAt             DateTime @default(now())

  searchRun PartSearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)

  @@index([searchRunId, decision])
  @@index([supplierId, article])
  @@index([reasonCode, createdAt])
  @@index([detectedCanonicalCode, createdAt])
}
