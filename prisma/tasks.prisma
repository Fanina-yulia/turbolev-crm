model CrmTask {
  id              String   @id @default(cuid())
  title           String   @db.VarChar(240)
  description     String?  @db.Text
  status          String   @default("OPEN") @db.VarChar(24)
  priority        String   @default("MEDIUM") @db.VarChar(16)
  assignedUserId  String   @db.VarChar(64)
  createdByUserId String?  @db.VarChar(64)
  dueAt           DateTime?
  remindAt        DateTime?
  completedAt     DateTime?
  sourceType      String   @default("MANUAL") @db.VarChar(32)
  sourceId        String?  @db.VarChar(96)
  clientId        String?  @db.VarChar(64)
  vehicleId       String?  @db.VarChar(64)
  autoGenerated   Boolean  @default(false)
  dedupeKey       String?  @unique @db.VarChar(180)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assignedUserId, status, dueAt])
  @@index([sourceType, sourceId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([createdAt])
}
