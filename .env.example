# Database
# Runtime: pooled Neon connection injected by Vercel Marketplace.
# Use verify-full explicitly to preserve certificate + hostname verification across pg major upgrades.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/turbolev?sslmode=verify-full"
# Prisma migrations: direct/unpooled connection when Neon provides it.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/turbolev?sslmode=verify-full"

# Neon Auth / Better Auth — server-side only.
# Preferred explicit Auth service base URL for the current Neon branch.
# Example shape: https://<endpoint>.neonauth.<region>.neon.tech/<database>/auth
# If omitted, Turbo LEV tries to derive it from the Neon DATABASE_URL as a compatibility fallback.
NEON_AUTH_BASE_URL=""

# Shared server-side encryption secret for credentials stored in CRM.
# Recommended in production. If omitted, existing integrations fall back to DATABASE_URL-derived encryption.
INTEGRATIONS_MASTER_KEY=""

# Reolink Camera Bridge — always-on service that owns UID/P2P connectivity.
# Example: https://camera-bridge.internal.example
# The CRM calls POST /v1/reolink/test on this service; do not expose Reolink passwords to the browser.
CAMERA_BRIDGE_URL=""
CAMERA_BRIDGE_TOKEN=""

# Binotel REST API — server-side only.
# API key and secret are required for REST actions such as recording lookup.
BINOTEL_API_KEY=""
BINOTEL_API_SECRET=""
BINOTEL_API_BASE_URL="https://api.binotel.com/api"
# Keep overrideable because the enabled API version depends on the Binotel account/API contract.
BINOTEL_API_VERSION="4.0"
BINOTEL_API_TIMEOUT_MS="10000"

# REQUIRED in production. Generate a long random secret (32+ characters).
# Configure Binotel callbacks to the same CRM endpoint and append ?token=...
BINOTEL_WEBHOOK_TOKEN=""

# Optional account metadata.
BINOTEL_COMPANY_ID=""

# Optional future realtime integration. Normal webhook + REST operation does not require these.
BINOTEL_WS_KEY=""
BINOTEL_WS_SECRET=""
BINOTEL_WS_URL="wss://ws.binotel.com:9002"

# Meta / Facebook Messenger / Instagram Direct.
# Prefer CRM → Налаштування → Інтеграції → Facebook + Instagram; these are ENV fallbacks only.
META_APP_ID=""
META_PAGE_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Override only when intentionally pinning another supported Graph API version.
META_GRAPH_VERSION="v26.0"

# OLX Partner API / OAuth.
# Prefer CRM → Налаштування → Інтеграції → OLX. OAuth access/refresh tokens are written by CRM after authorization.
OLX_CLIENT_ID=""
OLX_CLIENT_SECRET=""
OLX_ACCESS_TOKEN=""
OLX_REFRESH_TOKEN=""

# Vehicle Images / IMAGIN.studio — server-side only.
# Prefer CRM → Налаштування → Інтеграції → Vehicle Images · IMAGIN.studio.
# The customer ID is never exposed directly to browser UI; vehicle renders are proxied through CRM.
IMAGIN_CUSTOMER_ID=""
IMAGIN_BASE_URL="https://cdn.imagin.studio"
VEHICLE_IMAGE_ANGLE="23"
VEHICLE_IMAGE_WIDTH="400"
VEHICLE_IMAGE_FILE_TYPE="webp"
# AUTO = confirmed real color first, otherwise CRM theme color. Other values: REAL, THEME.
VEHICLE_IMAGE_COLOR_MODE="AUTO"
VEHICLE_IMAGE_FALLBACK_PAINT="Imagin-orange"

# Spare-parts suppliers. Keep credentials server-side only; never expose them as NEXT_PUBLIC_*.
# BM Parts: dedicated API key; configure BM_PARTS_API_KEY as a Vercel server-side secret.
BM_PARTS_API_KEY=""
BM_PARTS_API_BASE_URL="https://api.bm.parts"

# Unique Trade / Юнік Трейд API v2
UNIQUE_TRADE_EMAIL=""
UNIQUE_TRADE_PASSWORD=""
UNIQUE_TRADE_API_BASE_URL="https://order24-api.utr.ua"
UNIQUE_TRADE_BROWSER_FINGERPRINT="turbolev-crm-unique-trade-v2"

# AutoNova-D: fill these only after the manager provides official API credentials/documentation.
AUTONOVA_API_BASE_URL=""
AUTONOVA_API_LOGIN=""
AUTONOVA_API_PASSWORD=""

# ATL: optional ENV fallback. Prefer entering credentials in CRM → Налаштування → Інтеграції → Постачальники.
# Do not enable live search until ATL provides an official B2B/API endpoint and contract.
ATL_LOGIN=""
ATL_PASSWORD=""
ATL_API_BASE_URL=""
ATL_API_KEY=""
